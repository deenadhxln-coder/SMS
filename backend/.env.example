# ==============================================================================
# Environment Configuration Template (Placeholder Values Only)
# Copy this file to .env and configure environment-specific values.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=school_management
DB_SSL=false

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_for_production
JWT_EXPIRES_IN=1d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Razorpay Platform Billing (Test Mode Credentials)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_STANDARD_PLAN_ID=plan_standard_monthly
RAZORPAY_PREMIUM_PLAN_ID=plan_premium_monthly
